  "quotes": {
    "marquee": [
      {
        "text": "Я — живое существо, бесконечно близкое к совершенству.",
        "author": "Мудзан Кибуцуджи · Прародитель демонов"
      },
      {
        "text": "Будь благодарен за кровь. Не пролей на землю ни капли — иначе голова и тело расстанутся.",
        "author": "Кокушибо · Первая Высшая Луна"
      },
      {
        "text": "Я люблю людей. Всё, чего я хочу, — быть рядом с ними.",
        "author": "Доума · Вторая Высшая Луна"
      },
      {
        "text": "Стань демоном, Кёджуро. Мы сможем сражаться вечно.",
        "author": "Аказа · Третья Высшая Луна"
      },
      {
        "text": "Мы не брат и сестра. Мы — одна Шестая Высшая Луна.",
        "author": "Гютаро · Шестая Высшая Луна"
      },
      {
        "text": "Тот, кто красивее меня, не заслуживает жить.",
        "author": "Даки · Шестая Высшая Луна"
      },
      {
        "text": "Почему я? Почему Прародитель выбрал именно меня?",
        "author": "Энму · Первая Низшая Луна"
      },
      {
        "text": "Семья должна быть вместе. Семейные узы — это всё.",
        "author": "Руи · Пятая Низшая Луна"
      }
    ],
